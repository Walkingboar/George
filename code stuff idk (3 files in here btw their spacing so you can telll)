# ---------------- PIN CONFIGURATION: EDIT TO MATCH YOUR PCB ----------------
# Common 1.9-inch ST7789 SPI display. These are placeholders, NOT verified wiring.
TFT_SCK = board.GP18
TFT_MOSI = board.GP19
TFT_DC = board.GP16
TFT_CS = board.GP17       # Use None if your display CS pin is not connected.
TFT_RST = board.GP20
TFT_BL = board.GP21        # Set to None if backlight is wired directly to power.
TFT_WIDTH = 170
TFT_HEIGHT = 320
TFT_ROTATION = 90          # Common landscape orientation; adjust for your module.

KEY_PINS = [board.GP2, board.GP3, board.GP4, board.GP5]  # K1, K2, K3, K4
ENCODER_A = board.GP6
ENCODER_B = board.GP7
ENCODER_SW = board.GP8
NEOPIXEL_PIN = board.GP9
NEOPIXEL_COUNT = 4

# ---------------- USER SETTINGS ----------------
# Modes: "AUTO", "SPOTIFY", "YOUTUBE", "OSU", "CUSTOM"
# Use the Windows companion app to set the mode and send media details.
DEFAULT_MODE = "AUTO"
DEBOUNCE_SECONDS = 0.035
ENCODER_VOLUME_STEP = 1

# HID devices (CircuitPython normally exposes keyboard + consumer control by default).
keyboard = Keyboard(usb_hid.devices)
consumer = ConsumerControl(usb_hid.devices)

# Keys use active-low wiring with the other side connected to GND.
def make_button(pin):
    obj = digitalio.DigitalInOut(pin)
    obj.direction = digitalio.Direction.INPUT
    obj.pull = digitalio.Pull.UP
    return obj

keys = [make_button(pin) for pin in KEY_PINS]
encoder_button = make_button(ENCODER_SW)
encoder = rotaryio.IncrementalEncoder(ENCODER_A, ENCODER_B)
last_encoder_position = encoder.position

pixels = None
if neopixel is not None:
    try:
        pixels = neopixel.NeoPixel(NEOPIXEL_PIN, NEOPIXEL_COUNT, brightness=0.18, auto_write=True)
        pixels.fill((12, 20, 55))
    except Exception as exc:
        print("NeoPixel init failed:", exc)

# The USB CDC data interface is used by the Windows companion app.
serial = getattr(usb_cdc, "data", None)

mode = DEFAULT_MODE
media = {"title": "Ready to play", "artist": "Macro Pad", "app": "", "status": "Unknown", "username": "Player", "difficulty": "", "stars": ""}
last_key_state = [True, True, True, True]
last_key_change = [0, 0, 0, 0]
last_encoder_button = True
last_encoder_button_change = 0

# ---------------- DISPLAY ----------------
display = None
screen_group = None
text_title = None
text_subtitle = None
text_mode = None
text_footer = None

def init_display():
    global display, screen_group, text_title, text_subtitle, text_mode, text_footer
    if adafruit_st7789 is None:
        print("Missing adafruit_st7789 library; display disabled.")
        return
    try:
        displayio.release_displays()
        spi = busio.SPI(clock=TFT_SCK, MOSI=TFT_MOSI)
        while not spi.try_lock():
            pass
        spi.configure(baudrate=24000000, polarity=0, phase=0)
        spi.unlock()
        display_bus = displayio.FourWire(spi, command=TFT_DC, chip_select=TFT_CS, reset=TFT_RST)
        display = adafruit_st7789.ST7789(
            display_bus, width=TFT_WIDTH, height=TFT_HEIGHT,
            rotation=TFT_ROTATION, rowstart=0, colstart=0
        )
        screen_group = displayio.Group()
        display.root_group = screen_group
        # Optional custom background. Supply a BMP at the display's logical resolution.
        # Landscape modules often need a 320x170 BMP; portrait modules often need 170x320.
        try:
            bmp = displayio.OnDiskBitmap("background.bmp")
            bg = displayio.TileGrid(bmp, pixel_shader=bmp.pixel_shader)
            screen_group.append(bg)
            print("Loaded background.bmp:", bmp.width, "x", bmp.height)
        except Exception:
            bg_bitmap = displayio.Bitmap(display.width, display.height, 1)
            bg_palette = displayio.Palette(1)
            bg_palette[0] = 0x10162A
            screen_group.append(displayio.TileGrid(bg_bitmap, pixel_shader=bg_palette))
        text_mode = label.Label(terminalio.FONT, text="MODE: AUTO", color=0x71D9FF, x=8, y=12)
        text_title = label.Label(terminalio.FONT, text="Ready to play", color=0xFFFFFF, x=8, y=38)
        text_subtitle = label.Label(terminalio.FONT, text="Connect Windows app", color=0xB8C4E0, x=8, y=60)
        text_footer = label.Label(terminalio.FONT, text="K1 BACK  K2 PLAY", color=0xF2C879, x=8, y=display.height - 14)
        screen_group.append(text_mode)
        screen_group.append(text_title)
        screen_group.append(text_subtitle)
        screen_group.append(text_footer)
        update_display()
    except Exception as exc:
        display = None
        print("Display init failed:", repr(exc))

def fit(text, max_chars=36):
    text = str(text or "")
    return text if len(text) <= max_chars else text[:max_chars - 1] + "…"

def update_display():
    if display is None or text_title is None:
        return
    shown_mode = mode
    app = str(media.get("app", "")).lower()
    if mode == "AUTO":
        if "spotify" in app:
            shown_mode = "SPOTIFY"
        elif "chrome" in app or "edge" in app or "firefox" in app or "youtube" in app:
            shown_mode = "YOUTUBE"
    text_mode.text = "MODE: " + shown_mode
    if shown_mode == "OSU":
        text_title.text = fit(media.get("title") or "osu!", 34)
        extra = media.get("difficulty") or media.get("artist") or media.get("username", "Player")
        stars = media.get("stars", "")
        text_subtitle.text = fit((extra + ("  ★" + str(stars) if stars else "")), 34)
        text_footer.text = fit("PLAYER: " + str(media.get("username", "Player")), 34)
    else:
        text_title.text = fit(media.get("title") or "No media detected", 34)
        text_subtitle.text = fit(media.get("artist") or media.get("app") or "Waiting for media", 34)
        status = str(media.get("status", "Unknown")).upper()
        text_footer.text = fit("● " + status + "   K1 BACK  K2 PLAY", 34)

init_display()

# ---------------- BUTTON ACTIONS ----------------
def active_mode():
    if mode != "AUTO":
        return mode
    app = str(media.get("app", "")).lower()
    if "spotify" in app:
        return "SPOTIFY"
    if any(x in app for x in ("chrome", "edge", "firefox", "youtube")):
        return "YOUTUBE"
    return "YOUTUBE"  # Safe default for 5-second arrow-key seeking.

def tap_key(code):
    keyboard.press(code)
    time.sleep(0.025)
    keyboard.release_all()

def send_media(code):
    try:
        consumer.send(code)
    except Exception as exc:
        print("Consumer control failed:", exc)

def do_key(index):
    m = active_mode()
    # K1 = back 5s (YouTube arrow-left) / previous track (Spotify)
    # K2 = play/pause
    # K3 = forward 5s (YouTube arrow-right) / next track (Spotify)
    # K4 = next track (Spotify) / toggle fullscreen (YouTube; configurable)
    if index == 0:
        if m == "SPOTIFY":
            send_media(ConsumerControlCode.SCAN_PREVIOUS_TRACK)
        else:
            tap_key(Keycode.LEFT_ARROW)
    elif index == 1:
        if m == "SPOTIFY":
            send_media(ConsumerControlCode.PLAY_PAUSE)
        else:
            tap_key(Keycode.K)  # YouTube play/pause; player must have focus.
    elif index == 2:
        if m == "SPOTIFY":
            send_media(ConsumerControlCode.SCAN_NEXT_TRACK)
        else:
            tap_key(Keycode.RIGHT_ARROW)
    elif index == 3:
        if m == "SPOTIFY":
            send_media(ConsumerControlCode.SCAN_NEXT_TRACK)
        else:
            # YouTube next video shortcut: Shift+N. The video player must have focus.
            keyboard.press(Keycode.SHIFT, Keycode.N)
            time.sleep(0.025)
            keyboard.release_all()
    if pixels is not None:
        try:
            pixels.fill((0, 90, 55) if index == 1 else (35, 20, 100))
            time.sleep(0.045)
            pixels.fill((12, 20, 55))
        except Exception:
            pass




              

# ---------------- COMPANION APP SERIAL PROTOCOL ----------------
def poll_serial():
    global mode, media
    if serial is None:
        return
    try:
        while serial.in_waiting:
            line = serial.readline()
            if not line:
                break
            try:
                msg = json.loads(line.decode("utf-8").strip())
                if "mode" in msg:
                    new_mode = str(msg["mode"]).upper()
                    if new_mode in ("AUTO", "SPOTIFY", "YOUTUBE", "OSU", "CUSTOM"):
                        mode = new_mode
                if isinstance(msg.get("media"), dict):
                    media.update(msg["media"])
                else:
                    for key in ("title", "artist", "app", "status", "username", "difficulty", "stars"):
                        if key in msg:
                            media[key] = msg[key]
                update_display()
            except Exception as exc:
                print("Bad companion message:", exc)
    except Exception as exc:
        print("Serial read failed:", exc)

# Encoder rotates volume; pressing it cycles modes when no companion app is connected.
def handle_encoder():
    global last_encoder_position, last_encoder_button, last_encoder_button_change, mode
    position = encoder.position
    if position != last_encoder_position:
        delta = position - last_encoder_position
        last_encoder_position = position
        for _ in range(min(abs(delta), 8)):
            send_media(ConsumerControlCode.VOLUME_INCREMENT if delta > 0 else ConsumerControlCode.VOLUME_DECREMENT)
    now = time.monotonic()
    pressed = encoder_button.value
    if pressed != last_encoder_button and now - last_encoder_button_change >= DEBOUNCE_SECONDS:
        last_encoder_button = pressed
        last_encoder_button_change = now
        if not pressed:
            modes = ["AUTO", "SPOTIFY", "YOUTUBE", "OSU", "CUSTOM"]
            mode = modes[(modes.index(mode) + 1) % len(modes)] if mode in modes else "AUTO"
            update_display()
            if serial is not None:
                try:
                    serial.write((json.dumps({"event": "mode", "mode": mode}) + "\n").encode("utf-8"))
                except Exception:
                    pass

print("Macro pad ready. Set pin constants to match the PCB!")
while True:
    poll_serial()
    now = time.monotonic()
    for i, button in enumerate(keys):
        pressed = button.value
        if pressed != last_key_state[i] and now - last_key_change[i] >= DEBOUNCE_SECONDS:
            last_key_state[i] = pressed
            last_key_change[i] = now
            if not pressed:
                do_key(i)
    handle_encoder()
    time.sleep(0.005)





"""Windows companion for the RP2040 macro pad.

Install: py -m pip install pyserial winsdk
Run:     py windows_companion.py

The app sends Windows Media Session metadata (Spotify and browsers that publish a
media session) to the Pico over USB serial. It is a starter implementation: exact
song/difficulty/star-rating data for osu! is not exposed by the Windows media API.
"""
import asyncio
import json
import threading
import time
import tkinter as tk
from tkinter import ttk, messagebox

try:
    import serial
    from serial.tools import list_ports
except ImportError:
    serial = None
    list_ports = None

try:
    from winsdk.windows.media.control import GlobalSystemMediaTransportControlsSessionManager
except ImportError:
    GlobalSystemMediaTransportControlsSessionManager = None

MODES = ("AUTO", "SPOTIFY", "YOUTUBE", "OSU", "CUSTOM")

class Companion:
    def __init__(self, root):
        self.root = root
        self.root.title("Macro Pad Companion")
        self.root.geometry("460x380")
        self.port = None
        self.running = True
        self.mode = "AUTO"
        self.username = tk.StringVar(value="Player")
        self.status = tk.StringVar(value="Not connected")
        self.title_text = tk.StringVar(value="Waiting for media…")
        self.artist_text = tk.StringVar(value="")
        self._build_ui()
        self.refresh_ports()
        threading.Thread(target=self.media_loop, daemon=True).start()
        self.root.protocol("WM_DELETE_WINDOW", self.close)

    def _build_ui(self):
        pad = {"padx": 10, "pady": 5}
        ttk.Label(self.root, text="MACRO PAD COMPANION", font=("Segoe UI", 15, "bold")).pack(**pad)
        ttk.Label(self.root, textvariable=self.status).pack(**pad)
        row = ttk.Frame(self.root); row.pack(fill="x", **pad)
        self.port_combo = ttk.Combobox(row, state="readonly", width=20)
        self.port_combo.pack(side="left", padx=4)
        ttk.Button(row, text="Refresh", command=self.refresh_ports).pack(side="left", padx=4)
        ttk.Button(row, text="Connect", command=self.connect).pack(side="left", padx=4)
        ttk.Label(self.root, text="Mode (select what the screen/buttons should target):").pack(**pad)
        mode_row = ttk.Frame(self.root); mode_row.pack(**pad)
        for m in MODES:
            ttk.Button(mode_row, text=m, command=lambda m=m: self.set_mode(m)).pack(side="left", padx=2)
        ttk.Separator(self.root).pack(fill="x", padx=12, pady=8)
        ttk.Label(self.root, text="Now playing", font=("Segoe UI", 11, "bold")).pack()
        ttk.Label(self.root, textvariable=self.title_text, wraplength=420).pack(**pad)
        ttk.Label(self.root, textvariable=self.artist_text, wraplength=420).pack(**pad)
        userrow = ttk.Frame(self.root); userrow.pack(**pad)
        ttk.Label(userrow, text="osu! username:").pack(side="left")
        ttk.Entry(userrow, textvariable=self.username, width=22).pack(side="left", padx=5)
        ttk.Button(userrow, text="Send username", command=self.send_username).pack(side="left")
        ttk.Label(self.root, text="Custom background: copy a 170×320 or 320×170 BMP named background.bmp to CIRCUITPY.\nScreen dimensions/rotation depend on your exact ST7789 module.", wraplength=430).pack(**pad)

    def refresh_ports(self):
        if list_ports is None:
            self.status.set("Install dependencies: py -m pip install pyserial winsdk")
            return
        ports = [p.device for p in list_ports.comports()]
        self.port_combo["values"] = ports
        if ports and not self.port_combo.get():
            self.port_combo.current(0)

    def connect(self):
        if serial is None:
            messagebox.showerror("Missing package", "Run: py -m pip install pyserial winsdk")
            return
        port_name = self.port_combo.get()
        if not port_name:
            messagebox.showwarning("Select a port", "Choose the Pico's USB CDC data port first.")
            return
        try:
            if self.port:
                self.port.close()
            self.port = serial.Serial(port_name, 115200, timeout=0.1)
            time.sleep(1.0)
            self.status.set("Connected to " + port_name)
            self.send({"mode": self.mode})
        except Exception as exc:
            self.port = None
            messagebox.showerror("Connection failed", str(exc))

    def send(self, payload):
        if not self.port:
            return
        try:
            self.port.write((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))
        except Exception as exc:
            self.root.after(0, lambda: self.status.set("Serial error: " + str(exc)))

    def set_mode(self, mode):
        self.mode = mode
        self.send({"mode": mode})
        self.status.set("Mode: " + mode + (" (not connected)" if not self.port else ""))

    def send_username(self):
        self.send({"media": {"username": self.username.get()}})
        self.status.set("Username sent")

    def media_loop(self):
        if GlobalSystemMediaTransportControlsSessionManager is None:
            self.root.after(0, lambda: self.status.set("Install winsdk for media metadata: py -m pip install winsdk"))
            return
        while self.running:
            try:
                asyncio.run(self.read_media_once())
            except Exception:
                pass
            time.sleep(2.0)

    async def read_media_once(self):
        manager = await GlobalSystemMediaTransportControlsSessionManager.request_async()
        sessions = list(manager.get_sessions())
        best = None
        for session in sessions:
            try:
                props = await session.try_get_media_properties_async()
                title = str(props.title or "")
                artist = str(props.artist or "")
                app = str(session.source_app_user_model_id or "")
                if title or artist:
                    best = {"title": title, "artist": artist, "app": app, "status": "Playing/available"}
                    if "spotify" in app.lower():
                        break
            except Exception:
                continue
        if best:
            self.root.after(0, lambda b=best: self._update_media_ui(b))
            self.send({"media": best})

    def _update_media_ui(self, data):
        self.title_text.set(data.get("title", ""))
        self.artist_text.set(data.get("artist", ""))

    def close(self):
        self.running = False
        try:
            if self.port:
                self.port.close()
        except Exception:
            pass
        self.root.destroy()

if __name__ == "__main__":
    root = tk.Tk()
    app = Companion(root)
    root.mainloop()






  
